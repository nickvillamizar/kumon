# KUMON - Variables de entorno
# Copia este archivo como .env y completa los valores

DATABASE_URL=postgresql://usuario:password@host:5432/kumon_db
SECRET_KEY=genera-una-clave-secreta-aleatoria
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
CORS_EXTRA_ORIGINS=[]
MAX_VIDEO_SIZE_MB=100
OCR_CONFIDENCE_MIN=0.5
SPEECH_RATE_UMBRAL_BAJO=80
PAUSA_LARGA_MS=2000
ENABLE_FACE_ANALYSIS=False
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
ALLOWED_VIDEO_EXTENSIONS=["mp4","avi","mov","mkv"]
VALID_SUBJECTS=["matematicas","lenguaje","ingles"]
